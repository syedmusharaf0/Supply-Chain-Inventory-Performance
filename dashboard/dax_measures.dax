// ============================================================================
// Supply Chain & Inventory Performance — Power BI DAX measures
// Tables: dim_products, fact_daily_stock, fact_purchase_orders
// Columns use the friendly display names from the CSV headers.
// All monetary values in Indian Rupees (INR). Format currency measures as ₹.
//
// SETUP for the growth measures: add a calendar table (Modeling > New table):
//   Calendar = CALENDAR ( DATE ( 2023, 1, 1 ), DATE ( 2025, 6, 30 ) )
// and create a relationship Calendar[Date] -> fact_daily_stock[Stock Date].
// Mark Calendar as the date table. The growth measures below are the DAX
// equivalent of the SQL LAG() comparisons in sql/02_kpi_queries.sql.
// ============================================================================

// ---------- Core KPIs ----------
Total Units Sold = SUM ( fact_daily_stock[Units Sold] )

Lost Units = SUM ( fact_daily_stock[Lost Sales (units)] )

Total Demand = [Total Units Sold] + [Lost Units]

Stock-Out Rate % =
DIVIDE ( [Lost Units], [Total Demand] ) * 100

Sales Value INR =
SUMX (
    fact_daily_stock,
    fact_daily_stock[Units Sold] * RELATED ( dim_products[Unit Cost (INR)] )
)

Total Sales INR = [Sales Value INR]   // headline Total Sales measure

Lost Sales Value INR =
SUMX (
    fact_daily_stock,
    fact_daily_stock[Lost Sales (units)] * RELATED ( dim_products[Unit Cost (INR)] )
)

Average Inventory Value INR =
AVERAGEX (
    VALUES ( fact_daily_stock[Stock Date] ),
    CALCULATE ( SUMX ( fact_daily_stock, fact_daily_stock[Closing Stock (units)]
        * RELATED ( dim_products[Unit Cost (INR)] ) ) )
)

Stock Turnover Ratio =
DIVIDE ( [Sales Value INR], [Average Inventory Value INR] )
    * DIVIDE ( 365, DATEDIFF ( MIN ( fact_daily_stock[Stock Date] ),
                               MAX ( fact_daily_stock[Stock Date] ), DAY ) + 1 )

Carrying Cost INR =
[Average Inventory Value INR] * 0.20
    * DIVIDE ( DATEDIFF ( MIN ( fact_daily_stock[Stock Date] ),
                          MAX ( fact_daily_stock[Stock Date] ), DAY ) + 1, 365 )

Orders Late % =
DIVIDE (
    COUNTROWS ( FILTER ( fact_purchase_orders,
        fact_purchase_orders[Actual Lead Time (days)]
            > fact_purchase_orders[Promised Lead Time (days)] ) ),
    COUNTROWS ( fact_purchase_orders )
) * 100

Avg Lead Time Variance (days) =
AVERAGEX (
    fact_purchase_orders,
    fact_purchase_orders[Actual Lead Time (days)]
        - fact_purchase_orders[Promised Lead Time (days)]
)

Products Below Reorder Level =
COUNTROWS (
    FILTER (
        SUMMARIZE ( fact_daily_stock, dim_products[Product Code] ),
        CALCULATE ( SUM ( fact_daily_stock[Closing Stock (units)] ) )
            < MAX ( dim_products[Reorder Level] )
    )
)

// ---------- Growth comparisons (LAG equivalents) ----------
// Week-over-week
Units Sold Previous Week =
CALCULATE ( [Total Units Sold], DATEADD ( Calendar[Date], -7, DAY ) )

WoW Growth % =
DIVIDE ( [Total Units Sold] - [Units Sold Previous Week],
         [Units Sold Previous Week] ) * 100

// Month-over-month
Units Sold Previous Month =
CALCULATE ( [Total Units Sold], DATEADD ( Calendar[Date], -1, MONTH ) )

MoM Growth % =
DIVIDE ( [Total Units Sold] - [Units Sold Previous Month],
         [Units Sold Previous Month] ) * 100

// Year-over-year (same period last year)
Units Sold Same Period Last Year =
CALCULATE ( [Total Units Sold], SAMEPERIODLASTYEAR ( Calendar[Date] ) )

YoY Growth % =
DIVIDE ( [Total Units Sold] - [Units Sold Same Period Last Year],
         [Units Sold Same Period Last Year] ) * 100

Sales Value YoY Growth % =
VAR Cur = [Sales Value INR]
VAR Prev = CALCULATE ( [Sales Value INR], SAMEPERIODLASTYEAR ( Calendar[Date] ) )
RETURN DIVIDE ( Cur - Prev, Prev ) * 100
