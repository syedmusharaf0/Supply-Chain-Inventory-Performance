// Supply Chain & Inventory Performance — Power BI DAX measures
// Source tables: dim_products, fact_daily_stock, fact_purchase_orders
// All monetary values in Indian Rupees (INR). Format currency measures as ₹.

Total Units Sold = SUM ( fact_daily_stock[units_sold] )

Lost Units = SUM ( fact_daily_stock[lost_sales_units] )

Total Demand = [Total Units Sold] + [Lost Units]

Stock-Out Rate % =
DIVIDE ( [Lost Units], [Total Demand] ) * 100

Sales Value INR =
SUMX (
    fact_daily_stock,
    fact_daily_stock[units_sold] * RELATED ( dim_products[unit_cost_inr] )
)

Average Inventory Value INR =
AVERAGEX (
    VALUES ( fact_daily_stock[date] ),
    CALCULATE ( SUMX ( fact_daily_stock, fact_daily_stock[closing_stock]
        * RELATED ( dim_products[unit_cost_inr] ) ) )
)

Stock Turnover Ratio =
DIVIDE ( [Sales Value INR], [Average Inventory Value INR] )

Carrying Cost INR =
[Average Inventory Value INR] * 0.20 * DIVIDE ( 181, 365 )

Lost Sales Value INR =
SUMX (
    fact_daily_stock,
    fact_daily_stock[lost_sales_units] * RELATED ( dim_products[unit_cost_inr] )
)

Orders Late % =
DIVIDE (
    COUNTROWS ( FILTER ( fact_purchase_orders,
        fact_purchase_orders[actual_lead_time_days]
            > fact_purchase_orders[promised_lead_time_days] ) ),
    COUNTROWS ( fact_purchase_orders )
) * 100

Avg Lead Time Variance (days) =
AVERAGEX (
    fact_purchase_orders,
    fact_purchase_orders[actual_lead_time_days]
        - fact_purchase_orders[promised_lead_time_days]
)

SKUs Below Reorder Point =
COUNTROWS (
    FILTER (
        SUMMARIZE ( fact_daily_stock, dim_products[sku] ),
        CALCULATE ( SUM ( fact_daily_stock[closing_stock] ) )
            < MAX ( dim_products[reorder_point] )
    )
)
